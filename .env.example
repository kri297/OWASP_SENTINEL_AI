# OWASP Sentinel AI Configuration
# Copy this to .env and fill in values

# Optional: Google Gemini API Key for AI-powered analysis
# Get one from https://makersuite.google.com/app/apikey
# If not set, the system will use rule-based analysis instead
GEMINI_API_KEY=your_gemini_api_key_here


# Flask secret key (change in production)
SECRET_KEY=owasp-sentinel-ai-secret-key-change-me

# Database URI (default: SQLite)
DATABASE_URI=sqlite:///instance/sentinel.db
